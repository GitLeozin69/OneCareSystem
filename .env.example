HOST=127.0.0.1
PORT=3000
NODE_ENV=development
TZ=America/Fortaleza
LOG_LEVEL=info
TRUST_PROXY=false
# Em produção: domínio público exato do backend Railway; healthcheck.railway.app é aceito internamente.
ALLOWED_HOSTS=
IMPORT_MAX_FILE_SIZE_MB=10
IMPORT_MAX_ROWS=10000
# Preencha somente no .env local ou no cofre da hospedagem; nunca versione credenciais reais.
DATABASE_URL=
# Integrações: configure localmente; nunca use o banco operacional ou de produção.
TEST_DATABASE_URL=
FRONTEND_ORIGIN=http://127.0.0.1:5173,http://localhost:5173
SESSION_DURATION_HOURS=8
COOKIE_SECURE=false
# Obrigatório em produção: segredo aleatório com no mínimo 32 caracteres, fornecido pela hospedagem.
CSRF_SECRET=
