generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

enum UserRole {
  ADMIN
  VISUALIZADOR
}

model Usuario {
  id            Int        @id @default(autoincrement())
  username      String     @unique(map: "uq_usuarios_username") @db.VarChar(50)
  senhaHash     String     @map("senha_hash") @db.VarChar(255)
  role          UserRole   @default(VISUALIZADOR)
  ativo         Boolean    @default(true)
  adminSlot     Int?       @unique(map: "uq_usuarios_admin_slot") @map("admin_slot") @db.TinyInt
  ultimoLoginEm DateTime?  @map("ultimo_login_em") @db.DateTime(0)
  createdAt     DateTime   @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt     DateTime   @updatedAt @map("updated_at") @db.DateTime(0)
  sessoes       Sessao[]

  @@map("usuarios")
}

model Sessao {
  id         Int      @id @default(autoincrement())
  usuarioId  Int      @map("usuario_id")
  tokenHash  String   @unique(map: "uq_sessoes_token_hash") @map("token_hash") @db.Char(64)
  expiresAt  DateTime @map("expires_at") @db.DateTime(0)
  createdAt  DateTime @default(now()) @map("created_at") @db.DateTime(0)
  usuario    Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade, map: "fk_sessoes_usuario")

  @@index([usuarioId], map: "idx_sessoes_usuario")
  @@index([expiresAt], map: "idx_sessoes_expires_at")
  @@map("sessoes")
}

model Equipamento {
  id                    Int                 @id @default(autoincrement())
  serialNumber          String              @unique(map: "uq_equipamentos_serial_number") @map("serial_number") @db.VarChar(100)
  partNumber            String              @map("part_number") @db.VarChar(100)
  cliente               String              @db.VarChar(255)
  patrimonio            String?             @unique(map: "uq_equipamentos_patrimonio") @db.VarChar(100)
  notaFiscal            String?             @map("nota_fiscal") @db.VarChar(100)
  distribuidor          String              @db.VarChar(255)
  contratoOnecare       String?             @map("contrato_onecare") @db.VarChar(100)
  dataInicioOnecare     DateTime            @map("data_inicio_onecare") @db.Date
  dataFimOnecare        DateTime            @map("data_fim_onecare") @db.Date
  dataUltimaConferencia DateTime?           @map("data_ultima_conferencia") @db.Date
  arquivado             Boolean             @default(false)
  arquivadoEm           DateTime?           @map("arquivado_em") @db.DateTime(0)
  createdAt             DateTime            @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt             DateTime            @updatedAt @map("updated_at") @db.DateTime(0)
  notificacoes          Notificacao[]
  historicoContratos    HistoricoContrato[]

  @@index([arquivado, dataFimOnecare], map: "idx_equipamentos_arquivado_data_fim")
  @@map("equipamentos")
}

model Notificacao {
  id            Int         @id @default(autoincrement())
  equipamentoId Int         @map("equipamento_id")
  tipo          String      @db.VarChar(50)
  mensagem      String      @db.Text
  lida          Boolean     @default(false)
  eventoChave   String      @map("evento_chave") @db.VarChar(255)
  createdAt     DateTime    @default(now()) @map("created_at") @db.DateTime(0)
  equipamento   Equipamento @relation(fields: [equipamentoId], references: [id], onDelete: Cascade, map: "fk_notificacoes_equipamento")

  @@unique([equipamentoId, tipo, eventoChave], map: "uq_notificacao_evento")
  @@map("notificacoes")
}

model HistoricoContrato {
  id                Int         @id @default(autoincrement())
  equipamentoId     Int         @map("equipamento_id")
  contratoOnecare   String?     @map("contrato_onecare") @db.VarChar(100)
  dataInicioOnecare DateTime    @map("data_inicio_onecare") @db.Date
  dataFimOnecare    DateTime    @map("data_fim_onecare") @db.Date
  substituidoEm     DateTime    @default(now()) @map("substituido_em") @db.DateTime(0)
  equipamento       Equipamento @relation(fields: [equipamentoId], references: [id], onDelete: Cascade, map: "fk_historico_contratos_equipamento")

  @@index([equipamentoId], map: "idx_historico_contratos_equipamento")
  @@map("historico_contratos")
}
