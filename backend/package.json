{
  "name": "onecare-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=../.env --watch src/server.js",
    "start": "node --env-file-if-exists=../.env src/server.js",
    "lint": "eslint .",
    "test": "node --test \"test/*.test.js\"",
    "test:integration": "node --env-file-if-exists=../.env --test \"test/*Database.test.js\"",
    "build": "node --check src/app.js && node --check src/server.js && node --check prisma.config.js",
    "db:validate": "prisma validate",
    "db:generate": "prisma generate",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:status": "prisma migrate status"
  },
  "dependencies": {
    "@fastify/multipart": "^10.1.1",
    "@prisma/adapter-mariadb": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "dotenv": "^17.4.2",
    "fast-xml-parser": "^5.11.1",
    "fastify": "^5.12.3",
    "fflate": "^0.8.3",
    "read-excel-file": "^9.3.10"
  },
  "overrides": {
    "@prisma/adapter-mariadb": {
      "mariadb": "3.4.7"
    },
    "prisma": {
      "mysql2": "3.23.1"
    },
    "@prisma/config@7.10.0": {
      "deepmerge-ts": "8.0.0"
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "prisma": "^7.10.0",
    "write-excel-file": "^4.1.1"
  }
}
