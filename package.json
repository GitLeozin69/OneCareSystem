{
  "name": "onecare-system",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0 <25"
  },
  "scripts": {
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "lint": "npm --prefix backend run lint && npm --prefix frontend run lint",
    "test": "npm --prefix backend run test && npm --prefix frontend run test",
    "test:integration": "npm --prefix backend run test:integration",
    "build": "npm --prefix backend run build && npm --prefix frontend run build",
    "db:validate": "npm --prefix backend run db:validate",
    "db:generate": "npm --prefix backend run db:generate",
    "db:migrate:deploy": "npm --prefix backend run db:migrate:deploy",
    "db:migrate:status": "npm --prefix backend run db:migrate:status"
  }
}
